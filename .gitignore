# ── Secrets — never commit real env files ──────────────────────────────
.env
*.env
!*.env.example

# ── Health data — never commit the SQLite DB ───────────────────────────
# The project notes once claimed this was ignored; it wasn't. The documented workflow
# is `git add -A`, so a prod DB copied in for debugging would have been committed.
*.db
*.db-wal
*.db-shm

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ── Node / frontend ────────────────────────────────────────────────────
node_modules/
frontend/dist/

# ── Build artifact: backend/static is generated by `npm run build`
#    (source icons/manifest live in frontend/public) ────────────────────
backend/static/

# ── Collector runtime state (Mac-side) ─────────────────────────────────
scripts/.screentime_last
scripts/vendor/**/__pycache__/

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo

# Captured API payloads for the local render harness (contain real health data)
frontend/.hrr_fixture.json
frontend/.rd_fixture.json

# Local visual-check harness (not part of this repo). devharness/ holds its
# captured /api/nutrition/recent payload, which is real food-log data.
frontend/devharness.html
frontend/devharness/
